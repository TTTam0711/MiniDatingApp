@page "/"

<div class="home-container text-center">

    <!-- HEADER -->
    <div class="hero-section">
        <h1>Welcome to the Mini Dating App!</h1>
        <p>Find your match and schedule a date easily!</p>
    </div>

    <!-- ACTION CARDS -->
    <div class="row justify-content-center mt-4 g-4">

        <!-- CREATE PROFILE -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <a href="/create-profile" class="text-decoration-none">
                <div class="card action-card card-blue">
                    <div class="card-body text-center">
                        <i class="bi bi-person-plus"></i>
                        <h5>Create Profile</h5>
                    </div>
                </div>
            </a>
        </div>

        <!-- VIEW PROFILES -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <a href="/profiles" class="text-decoration-none">
                <div class="card action-card card-green">
                    <div class="card-body text-center">
                        <i class="bi bi-card-list"></i>
                        <h5>View Profiles</h5>
                    </div>
                </div>
            </a>
        </div>

        <!-- MATCHES -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <a href="/matches" class="text-decoration-none">
                <div class="card action-card card-pink">
                    <div class="card-body text-center">
                        <i class="bi bi-heart-fill"></i>
                        <h5>Your Matches</h5>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- FOOTER -->
    <div class="mt-5 text-muted">
        <small>Test Prototype © 2026 Clique83.com</small>
    </div>

</div>