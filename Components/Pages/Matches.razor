@page "/matches"
@rendermode InteractiveServer

@using MiniDatingApp.Models
@using MiniDatingApp.Services

@inject MatchService MatchService
@inject ProfileService ProfileService
@inject NavigationManager Navigation

<div class="container mt-4">

    <h2 class="text-center mb-4">💖 Your Matches</h2>

    <!-- SELECT USER -->
    <div class="text-center mb-4">
        <label class="me-2 fw-semibold">Select User:</label>

        <select class="form-select w-auto d-inline-block"
                value="@currentUserId"
                @onchange="OnUserChange">

            @foreach (var p in profiles)
            {
                <option value="@p.Id">@p.Name</option>
            }

        </select>
    </div>

    @if (!matchedProfiles.Any())
    {
        <div class="text-center text-muted">
            😢 No matches yet. Go like someone first!
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var p in matchedProfiles)
            {
                var slot = matchSlots.ContainsKey(p.Id) ? matchSlots[p.Id] : null;
                var bothHaveAvailability = bothAvailability.Contains(p.Id);

                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm p-3 h-100 border-0 rounded-4">

                        <!-- PROFILE -->
                        <div class="mb-2">
                            <h5 class="fw-bold">@p.Name (@p.Age)</h5>
                            <p class="text-muted mb-1">@p.Gender</p>
                        </div>

                        <!-- STATUS -->
                        <div class="mb-3">

                            @if (slot != null)
                            {
                                <div class="alert alert-success">
                                    <div class="fw-semibold">📅 Date Confirmed</div>
                                    <div>
                                        <strong>
                                            @slot.Value.start.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            -
                                            @slot.Value.end.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </strong>
                                    </div>
                                </div>
                            }
                            else if (bothHaveAvailability)
                            {
                                <div class="alert alert-danger">
                                    ❌ No common time found
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    ⏳ Waiting for availability
                                </div>
                            }

                        </div>

                        <!-- BUTTON -->
                        <button class="btn btn-primary mt-auto w-100"
                                @onclick="() => GoToAvailability(p.Id)">
                            📅 Add Availability
                        </button>

                    </div>
                </div>
            }

        </div>
    }

</div>

@code {
    private List<Profile> profiles = new();
    private List<Profile> matchedProfiles = new();

    private Guid currentUserId;

    private Dictionary<Guid, (DateTime start, DateTime end)?> matchSlots = new();
    private HashSet<Guid> bothAvailability = new();

    // =========================
    // 🔹 INIT
    // =========================
    protected override async Task OnInitializedAsync()
    {
        profiles = await ProfileService.GetAllAsync();

        if (profiles.Any())
        {
            currentUserId = profiles.First().Id;
            await LoadData();
        }
    }

    // =========================
    // 🔹 CHANGE USER
    // =========================
    private async Task OnUserChange(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var newUserId))
        {
            currentUserId = newUserId;
            await LoadData();
        }
    }

    // =========================
    // 🔹 LOAD DATA
    // =========================
    private async Task LoadData()
    {
        matchedProfiles = await MatchService.GetMatchesForUser(currentUserId);

        matchSlots.Clear();
        bothAvailability.Clear();

        foreach (var p in matchedProfiles)
        {
            // 🔥 LẤY MATCH
            var match = await MatchService.GetMatch(currentUserId, p.Id);
            if (match == null) continue;

            // 🔹 SLOT THEO MATCH
            var slot = await MatchService.GetMatchSlot(match.Id);
            matchSlots[p.Id] = slot;

            // 🔹 CHECK AVAILABILITY THEO MATCH
            var (hasA, hasB) = await MatchService.CheckBothAvailability(match.Id);

            if (hasA && hasB)
            {
                bothAvailability.Add(p.Id);
            }
        }
    }

    // =========================
    // 🔹 NAVIGATION
    // =========================
    private async Task GoToAvailability(Guid otherUserId)
    {
        var match = await MatchService.GetMatch(currentUserId, otherUserId);

        if (match != null)
        {
            Navigation.NavigateTo($"/availabilitypage/{match.Id}/{currentUserId}/{otherUserId}");
        }
    }
}